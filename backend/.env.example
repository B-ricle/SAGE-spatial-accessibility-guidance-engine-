# Backend-only configuration, loaded from the repository-root .env.
SAGE_APP_TITLE=SAGE API
GEMINI_API_KEY=replace-with-private-key
SAGE_GEMINI_MODEL=gemini-3.5-flash
SAGE_SUPABASE_URL=https://your-project.supabase.co
SAGE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SAGE_ALLOWED_ORIGINS=["http://127.0.0.1:5173","capacitor://localhost","https://your-app.example"]
SAGE_DEMO_ENABLED=true
